{
    "[nix]": {
        "editor.defaultFormatter": "jnoortheen.nix-ide"
    },
    "nix.formatterPath": [
        "nixfmt"
    ],
    "yaml.format.singleQuote": true,
    "[yaml]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
        "editor.insertSpaces": true
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "editor.formatOnSave": true,
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "nixEnvSelector.nixFile": "${workspaceFolder}/flake.nix",
    "nix.enableLanguageServer": true,
    "nix.serverPath": "nixd",
    "nix.serverSettings": {
        "nixd": {
            "nixpkgs": {
                "expr": "import (builtins.getFlake (toString ./.)).inputs.nixpkgs { }"
            },
            "formatting": {
                "command": [
                    "nix",
                    "fmt"
                ]
            },
            "options": {
                "nixos": {
                    "expr": "let flake = builtins.getFlake (toString ./.); inherit (flake.inputs.nixpkgs) lib; configs = flake.nixosConfigurations; in lib.recursiveUpdate (lib.recursiveUpdate configs.sentinel.options configs.thelessnas.options) configs.thelessone.options"
                },
                "home-manager": {
                    "expr": "(builtins.getFlake (toString ./.)).homeConfigurations.thelessone.options"
                },
                "flake-parts": {
                    "expr": "let flake = builtins.getFlake (toString ./.); in flake.debug.options // flake.currentSystem.options"
                }
            }
        }
    }
}